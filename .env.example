# Both docker-compose.yml (default) and docker-compose.unified.yml use
# project model-intent-unified, service db, and its EXISTING named volume.
# Docker Compose reads .env for interpolation; Streamlit can load DATABASE_URL
# from the project .env if the process has no URL. Admin CLI does NOT load .env.
# Export DATABASE_URL in your shell before using admin commands.
UNIFIED_POSTGRES_USER=model_intent
UNIFIED_POSTGRES_PASSWORD=model_intent_dev
UNIFIED_POSTGRES_PORT=5433
DATABASE_URL=postgresql://model_intent:model_intent_dev@127.0.0.1:5433/model_intent_unified
